{
  "actionType": "publish_post",
  "platform": "X",
  "version": "1.1.0",
  "description": "Publish content (tweet) to X (Twitter)",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": false,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      "text"
    ],
    "optional": [
      "media"
    ]
  },
  "outputs": {
    "success": [],
    "failure": []
  },
  "steps": [
    {
      "id": "navigate_to_home",
      "type": "navigate",
      "url": "https://x.com/home",
      "waitFor": "page_load",
      "timeout": 30
    },
    {
      "id": "wait_for_page",
      "type": "wait",
      "duration": 2.0,
      "waitFor": "time"
    },
    {
      "id": "find_tweet_input",
      "type": "find_element",
      "selector": "div[data-testid='tweetTextarea_0']",
      "alternatives": [
        "//div[@contenteditable='true' and @data-testid='tweetTextarea_0']",
        "div[role='textbox']"
      ],
      "timeout": 15
    },
    {
      "id": "click_input",
      "type": "click",
      "elementRef": "find_tweet_input"
    },
    {
      "id": "type_tweet",
      "type": "type",
      "elementRef": "find_tweet_input",
      "text": "{{text}}",
      "humanLike": true
    },
    {
      "id": "wait_after_type",
      "type": "wait",
      "duration": 1.5,
      "waitFor": "time"
    },
    {
      "id": "find_tweet_button",
      "type": "find_element",
      "selector": "button[data-testid='tweetButtonInline']",
      "alternatives": [
        "button[data-testid='tweetButton']",
        "//button[@data-testid='tweetButtonInline']",
        "//button[@data-testid='tweetButton']"
      ],
      "timeout": 10
    },
    {
      "id": "click_tweet",
      "type": "click",
      "elementRef": "find_tweet_button"
    },
    {
      "id": "wait_after_post",
      "type": "wait",
      "duration": 3.0,
      "waitFor": "time"
    }
  ],
  "errorHandling": {
    "globalRetries": 3,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
